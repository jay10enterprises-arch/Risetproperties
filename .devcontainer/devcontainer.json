{
  "name": "Riset Properties - PHP & MySQL",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.0-mariadb",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "felixbecker.php-intellisense",
        "bmewburn.vscode-intelephense-client",
        "emallin.phpunit",
        "DBSource.dbsource"
      ],
      "settings": {
        "php.validate.executablePath": "/usr/bin/php"
      }
    }
  },
  "forwardPorts": [
    8080,
    3306
  ],
  "remoteUser": "root",
  "postCreateCommand": "bash .devcontainer/post-create.sh"

 
}
